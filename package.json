{
  "name": "@virasak/typst-math-wasm",
  "version": "0.1.0",
  "description": "Lightweight math-only WebAssembly Typst compiler with embedded Computer Modern fonts",
  "type": "module",
  "main": "./pkg/typst_math_wasm.js",
  "types": "./pkg/typst_math_wasm.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/typst_math_wasm.d.ts",
      "import": "./pkg/typst_math_wasm.js"
    },
    "./wasm": "./pkg/typst_math_wasm_bg.wasm"
  },
  "files": [
    "pkg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "wasm-pack build --target web --release --out-dir pkg && rm -f pkg/.gitignore && node -e 'const p = \"pkg/package.json\"; if (fs.existsSync(p)) { const j = JSON.parse(fs.readFileSync(p)); j.name = \"@virasak/typst-math-wasm\"; fs.writeFileSync(p, JSON.stringify(j, null, 2) + \"\\n\"); }'",
    "opt:wasm": "wasm-opt --all-features -Oz pkg/typst_math_wasm_bg.wasm -o pkg/typst_math_wasm_bg.wasm",
    "build": "npm run build:wasm && npm run opt:wasm",
    "prepublishOnly": "npm run build",
    "publish:stage": "npm publish --access public --tag stage",
    "publish:latest": "npm publish --access public",
    "stage:publish": "npm stage publish",
    "stage:list": "npm stage list",
    "serve": "npx serve ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virasak/typst-math-wasm.git"
  },
  "keywords": [
    "typst",
    "math",
    "wasm",
    "webassembly",
    "katex",
    "svg",
    "latex",
    "formula"
  ],
  "author": "Virasak Dungsrikaew",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/virasak/typst-math-wasm/issues"
  },
  "homepage": "https://github.com/virasak/typst-math-wasm#readme"
}
